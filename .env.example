# =========================================================================
# Neo4j AuraDB Free 雲端資料庫連線設定 (範例模板)
# =========================================================================
# 請複製此檔案並重新命名為 .env.local，然後填入您的連線資訊。

# AuraDB 連接網址 (通常以 neo4j+s:// 開頭)
NEO4J_URI=neo4j+s://<您的-db-id>.databases.neo4j.io

# 使用者名稱 (AuraDB Free 預設均為 neo4j)
NEO4J_USERNAME=neo4j

# AuraDB 自動產生的密碼
NEO4J_PASSWORD=<您的-db-密碼>

# 預設資料庫名稱 (AuraDB Free 通常預設為 neo4j)
NEO4J_DATABASE=neo4j

# =========================================================================
# 雲端管理參數 (僅供參考/備份)
# =========================================================================
AURA_INSTANCEID=<您的-AURA_INSTANCEID>
AURA_INSTANCENAME=<您的-AURA_INSTANCENAME>

# =========================================================================
# OpenAI API 設定 (用於向量嵌入 Embedding 與 LLM 檢索分析)
# =========================================================================
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
